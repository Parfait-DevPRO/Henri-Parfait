# Backblaze B2 private bucket. Use an application key limited to this bucket
# with read-only access.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=projetApk

# Object names (paths) inside the bucket.
B2_OBJECT_TILAPIA_FARM=Tilapia_farm.apk
B2_OBJECT_RESEAU_SOCIAL=Reseau_Social.apk
B2_OBJECT_GESTION_PAIE=Société_Paie.zip

# Restrict this to the deployed portfolio origin in production.
CORS_ORIGIN=http://localhost:5173
